# ── 데이터베이스 (Neon Postgres) ─────────────────────────────
# Vercel에서 Storage > Neon을 연결하면 아래 값이 자동으로 채워진다.
# 로컬 개발에는 Neon에서 만든 "개발용" 브랜치/데이터베이스의 주소를 쓴다.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── 로그인 ──────────────────────────────────────────────────
# 사이트에 들어갈 때 입력할 비밀번호
APP_PASSWORD=
# 로그인 쿠키 서명용 비밀 값. 아래 명령으로 만든 긴 무작위 문자열을 넣는다.
#   openssl rand -base64 32
AUTH_SECRET=

# ── 공개 데모 (선택) ─────────────────────────────────────────
# true로 두면 로그인 없이 누구나 볼 수 있는 읽기 전용 데모가 된다. (가상의 샘플 데이터, DB 불필요)
# 이때 APP_PASSWORD, AUTH_SECRET은 비워 둔다. 함께 설정하면 안전을 위해 사이트가 막힌다.
DEMO_MODE=
